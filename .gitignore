# Python
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/
venv/

# Packaging
*.egg-info/
build/
dist/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Benchmark outputs
outputs/
reports/
cache/

# Datasets (generated)
datasets/raw/*
datasets/processed/*

# Keep directory structure
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep
!outputs/.gitkeep
!reports/.gitkeep

# Logs
*.log
bsi-benchmark-results/

# Downloaded/local BSI prompt copies (not part of this tool's source)
MASTER_PROMPT_BSI_v3.4.2.md
*.md.1

# Accidentally-cloned repos inside this one (happened once - never again)
behmanesh-index-prompt/

# Run outputs (generated by `compare`/`run`, not source) -- only the
# curated self-compare records under results/self_compare/ are tracked;
# raw one-off experiment/test runs directly under results/ stay untracked.
results/*
!results/.gitkeep
!results/self_compare/
!results/self_compare/**
*_test.json
*_test.md
*_test2.json
*_test2.md
demo_run.json
demo_run.md
report.html
articles/
*.bak
*.debug
backups/
